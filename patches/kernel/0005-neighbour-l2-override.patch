From: srcdynroute project <srcdynroute@local>
Subject: [PATCH 0005] srcdynroute: neighbour L2 (source MAC) override

Generated by diff -ruN against pristine linux-6.12.111.
Apply with
'git apply' or 'patch -p1 -d <kbuild-root>'.

--- a/net/core/neighbour.c	2026-10-08 03:36:45.297984539 +0300
+++ b/net/core/neighbour.c	2026-10-08 03:36:45.325984539 +0300
@@ -38,6 +38,7 @@
 #include <linux/log2.h>
 #include <linux/inetdevice.h>
 #include <net/addrconf.h>
+#include <net/netfilter/dynrt.h>
 
 #include <trace/events/neigh.h>
 
@@ -1555,15 +1556,29 @@
 		int err;
 		struct net_device *dev = neigh->dev;
 		unsigned int seq;
+		const unsigned char *dst = neigh->ha;
 
 		if (dev->header_ops->cache && !READ_ONCE(neigh->hh.hh_len))
 			neigh_hh_init(neigh);
 
+#if IS_ENABLED(CONFIG_NF_DYNRT)
+		/*
+		 * Dynamic source routing (DYNSRCROUTE target / DYNRT match):
+		 * override the L2 destination with the stored peer address
+		 * when a valid slot matches this packet's direction and the
+		 * device is compatible; otherwise keep the ordinary
+		 * neighbour resolution.
+		 */
+		dst = dynrt_force_mac(skb, dev);
+		if (!dst)
+			dst = neigh->ha;
+#endif
+
 		do {
 			__skb_pull(skb, skb_network_offset(skb));
 			seq = read_seqbegin(&neigh->ha_lock);
 			err = dev_hard_header(skb, dev, ntohs(skb->protocol),
-					      neigh->ha, NULL, skb->len);
+					      dst, NULL, skb->len);
 		} while (read_seqretry(&neigh->ha_lock, seq));
 
 		if (err >= 0)
@@ -1587,12 +1602,20 @@
 	struct net_device *dev = neigh->dev;
 	unsigned int seq;
 	int err;
+	const unsigned char *dst = neigh->ha;
+
+#if IS_ENABLED(CONFIG_NF_DYNRT)
+	/* Dynamic source routing: see neigh_resolve_output(). */
+	dst = dynrt_force_mac(skb, dev);
+	if (!dst)
+		dst = neigh->ha;
+#endif
 
 	do {
 		__skb_pull(skb, skb_network_offset(skb));
 		seq = read_seqbegin(&neigh->ha_lock);
 		err = dev_hard_header(skb, dev, ntohs(skb->protocol),
-				      neigh->ha, NULL, skb->len);
+				      dst, NULL, skb->len);
 	} while (read_seqretry(&neigh->ha_lock, seq));
 
 	if (err >= 0)
