 # netlink interface for nf_conntrack
 obj-$(CONFIG_NF_CT_NETLINK) += nf_conntrack_netlink.o
--- a/net/netfilter/nf_dynrt.c	1970-01-01 03:00:00.000000000 +0300
+++ b/net/netfilter/nf_dynrt.c	2026-10-08 03:36:45.317984539 +0300
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * nf_dynrt.c -- built-in helper for per-direction dynamic source routing.
+ *
+ * This object deliberately references *zero* conntrack/netfilter symbols:
+ * it only keeps an RCU-protected pointer to a dynrt_ops structure filled in
+ * by the out-of-tree "srcdynroute" module (which links nf_conntrack).
+ *
+ * Every conntrack call (nf_ct_get, nf_conntrack_find_get, nf_ct_ext_*,
+ * direction computation) lives in the module. The pattern follows
+ * nf_nat_register_fn():
+ *
+ *    rcu_read_lock();
+ *    ops = rcu_dereference(dynrt_ops);
+ *    if (ops && try_module_get(ops->owner)) { <call>; module_put(ops->owner); }
+ *    rcu_read_unlock();
+ *
+ * When no module is registered (ops == NULL) every wrapper is a no-op:
+ * that is logically consistent, because without the module nobody writes
+ * the src_dyn_rt extension slots, so there is nothing to force.
+ */
+
+#include <linux/module.h>
+#include <linux/rcupdate.h>
+#include <linux/skbuff.h>
+#include <net/netfilter/dynrt.h>
+
+static const struct dynrt_ops __rcu *dynrt_ops;
+
+int dynrt_register(const struct dynrt_ops *ops)
+{
+	if (!ops || !ops->oif_skb || !ops->oif_fl4 || !ops->oif_fl6 ||
+	    !ops->mac || !ops->owner)
+		return -EINVAL;
+
+	rcu_assign_pointer(dynrt_ops, ops);
+	synchronize_rcu();
+	return 0;
+}
+EXPORT_SYMBOL_GPL(dynrt_register);
+
+void dynrt_unregister(void)
+{
+	rcu_assign_pointer(dynrt_ops, NULL);
+	synchronize_rcu();
+}
+EXPORT_SYMBOL_GPL(dynrt_unregister);
+
+u32 dynrt_force_oif_skb(struct sk_buff *skb)
+{
+	const struct dynrt_ops *ops;
+	u32 oif = 0;
+
+	rcu_read_lock();
+	ops = rcu_dereference(dynrt_ops);
+	if (ops && try_module_get(ops->owner)) {
+		oif = ops->oif_skb(skb);
+		module_put(ops->owner);
+	}
+	rcu_read_unlock();
+	return oif;
+}
+EXPORT_SYMBOL_GPL(dynrt_force_oif_skb);
+
+u32 dynrt_force_oif_fl4(struct net *net, const struct flowi4 *fl4)
+{
+	const struct dynrt_ops *ops;
+	u32 oif = 0;
+
+	rcu_read_lock();
+	ops = rcu_dereference(dynrt_ops);
+	if (ops && try_module_get(ops->owner)) {
+		oif = ops->oif_fl4(net, fl4);
+		module_put(ops->owner);
+	}
+	rcu_read_unlock();
+	return oif;
+}
+EXPORT_SYMBOL_GPL(dynrt_force_oif_fl4);
+
+u32 dynrt_force_oif_fl6(struct net *net, const struct flowi6 *fl6)
+{
+	const struct dynrt_ops *ops;
+	u32 oif = 0;
+
+	rcu_read_lock();
+	ops = rcu_dereference(dynrt_ops);
+	if (ops && try_module_get(ops->owner)) {
+		oif = ops->oif_fl6(net, fl6);
+		module_put(ops->owner);
+	}
+	rcu_read_unlock();
+	return oif;
+}
+EXPORT_SYMBOL_GPL(dynrt_force_oif_fl6);
+
+const u8 *dynrt_force_mac(struct sk_buff *skb, struct net_device *dev)
+{
+	const struct dynrt_ops *ops;
+	const u8 *mac = NULL;
+
+	rcu_read_lock();
+	ops = rcu_dereference(dynrt_ops);
+	if (ops && try_module_get(ops->owner)) {
+		mac = ops->mac(skb, dev);
+		module_put(ops->owner);
+	}
+	rcu_read_unlock();
+	return mac;
+}
+EXPORT_SYMBOL_GPL(dynrt_force_mac);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("built-in ops helper for dynamic per-direction source routing");
