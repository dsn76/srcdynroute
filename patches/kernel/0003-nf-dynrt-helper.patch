From: srcdynroute project <srcdynroute@local>
Subject: [PATCH 0003] srcdynroute: net/netfilter/nf_dynrt.c RCU ops helpers + Kconfig/Makefile

Generated by diff -ruN against pristine linux-6.12.111.
Apply with
'git apply' or 'patch -p1 -d <kbuild-root>'.

--- a/net/netfilter/Kconfig	2026-10-08 03:36:45.285984538 +0300
+++ b/net/netfilter/Kconfig	2026-10-08 03:36:45.317984539 +0300
@@ -21,6 +21,20 @@
 config NETFILTER_SKIP_EGRESS
 	def_bool NETFILTER_EGRESS && (NET_CLS_ACT || IFB)
 
+config NF_DYNRT
+	bool "Dynamic per-direction source routing (DYNSRCROUTE/DYNRT)"
+	default y
+	help
+	  In-kernel helper for the out-of-tree "srcdynroute" nft target
+	  (DYNSRCROUTE) and match (DYNRT): per-connection, per-direction
+	  output-ifindex + peer L2 address stored in a conntrack extension
+	  (NF_CT_EXT_SRC_DYN_RT), applied at FIB (forced oif, IPv4/IPv6) and
+	  neighbour level (L2 destination override).
+
+	  This built-in keeps only an RCU pointer to ops filled by the
+	  out-of-tree module; it references no conntrack symbols and is a
+	  complete no-op when the module is not loaded.
+
 config NETFILTER_NETLINK
 	tristate
 
