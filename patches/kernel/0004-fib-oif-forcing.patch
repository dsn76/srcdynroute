From: srcdynroute project <srcdynroute@local>
Subject: [PATCH 0004] srcdynroute: FIB oif forcing for ipv4/ipv6 route lookups

Generated by diff -ruN against pristine linux-6.12.111.
Apply with
'git apply' or 'patch -p1 -d <kbuild-root>'.

--- a/net/ipv4/route.c	2026-10-08 03:36:45.293984539 +0300
+++ b/net/ipv4/route.c	2026-10-08 03:36:45.325984539 +0300
@@ -98,6 +98,8 @@
 #include <net/lwtunnel.h>
 #include <net/netevent.h>
 #include <net/rtnetlink.h>
+#include <net/netfilter/dynrt.h>
+
 #ifdef CONFIG_SYSCTL
 #include <linux/sysctl.h>
 #endif
@@ -2344,7 +2346,29 @@
 		fl4.fl4_dport = 0;
 	}
 
+#if IS_ENABLED(CONFIG_NF_DYNRT)
+	/*
+	 * Dynamic source routing (DYNSRCROUTE target / DYNRT match):
+	 * if a valid per-direction slot exists for this packet, force
+	 * the stored output ifindex. On a rejected lookup fall back to
+	 * the normal (unrestricted) one.
+	 */
+	{
+		u32 dynrt_oif = dynrt_force_oif_skb(skb);
+
+		if (dynrt_oif) {
+			fl4.flowi4_oif = dynrt_oif;
+			err = fib_lookup(net, &fl4, res, 0);
+			if (err != 0) {
+				fl4.flowi4_oif = 0;
+				err = fib_lookup(net, &fl4, res, 0);
+			}
+		} else
+			err = fib_lookup(net, &fl4, res, 0);
+	}
+#else
 	err = fib_lookup(net, &fl4, res, 0);
+#endif
 	if (err != 0) {
 		if (!IN_DEV_FORWARD(in_dev))
 			err = -EHOSTUNREACH;
@@ -2914,7 +2938,35 @@
 struct rtable *ip_route_output_flow(struct net *net, struct flowi4 *flp4,
 				    const struct sock *sk)
 {
-	struct rtable *rt = __ip_route_output_key(net, flp4);
+	struct rtable *rt;
+	bool dynrt_routed = false;
+
+#if IS_ENABLED(CONFIG_NF_DYNRT)
+	/*
+	 * Dynamic source routing (DYNSRCROUTE target / DYNRT match):
+	 * forced output ifindex, with one fallback lookup using the
+	 * caller's original oif. The forced value must not leak out
+	 * of this function.
+	 */
+	{
+		u32 dynrt_oif = dynrt_force_oif_fl4(net, flp4);
+		u32 saved_oif = flp4->flowi4_oif;
+
+		if (dynrt_oif) {
+			flp4->flowi4_oif = dynrt_oif;
+			rt = __ip_route_output_key(net, flp4);
+			if (IS_ERR(rt)) {
+				flp4->flowi4_oif = saved_oif;
+				rt = __ip_route_output_key(net, flp4);
+			}
+			flp4->flowi4_oif = saved_oif;
+			dynrt_routed = true;
+		}
+	}
+#endif
+
+	if (!dynrt_routed)
+		rt = __ip_route_output_key(net, flp4);
 
 	if (IS_ERR(rt))
 		return rt;
--- a/net/ipv6/route.c	2026-10-08 03:36:45.293984539 +0300
+++ b/net/ipv6/route.c	2026-10-08 03:36:45.325984539 +0300
@@ -57,6 +57,7 @@
 #include <net/netevent.h>
 #include <net/netlink.h>
 #include <net/rtnh.h>
+#include <net/netfilter/dynrt.h>
 #include <net/lwtunnel.h>
 #include <net/ip_tunnels.h>
 #include <net/l3mdev.h>
@@ -2346,10 +2347,43 @@
 					 const struct sk_buff *skb,
 					 int flags)
 {
+	struct dst_entry *dst;
+
 	if (rt6_need_strict(&fl6->daddr) && dev->type != ARPHRD_PIMREG)
 		flags |= RT6_LOOKUP_F_IFACE;
 
-	return fib6_rule_lookup(net, fl6, skb, flags, ip6_pol_route_input);
+#if IS_ENABLED(CONFIG_NF_DYNRT)
+	/*
+	 * Dynamic source routing (DYNSRCROUTE target / DYNRT match):
+	 * forced output ifindex, with one fallback lookup using the
+	 * original flowi/flags.
+	 */
+	{
+		u32 dynrt_oif = dynrt_force_oif_skb(
+				(struct sk_buff *)(const struct sk_buff *)skb);
+
+		if (dynrt_oif) {
+			u32 saved_oif = fl6->flowi6_oif;
+			int saved_flags = flags;
+
+			fl6->flowi6_oif = dynrt_oif;
+			flags |= RT6_LOOKUP_F_IFACE;
+			dst = fib6_rule_lookup(net, fl6, skb, flags,
+					       ip6_pol_route_input);
+			if (!dst) {
+				fl6->flowi6_oif = saved_oif;
+				flags = saved_flags;
+				dst = fib6_rule_lookup(net, fl6, skb, flags,
+						       ip6_pol_route_input);
+			}
+			fl6->flowi6_oif = saved_oif;
+			return dst;
+		}
+	}
+#endif
+
+	dst = fib6_rule_lookup(net, fl6, skb, flags, ip6_pol_route_input);
+	return dst;
 }
 EXPORT_SYMBOL_GPL(ip6_route_input_lookup);
 
@@ -2664,11 +2698,10 @@
 						      int flags)
 {
 	bool any_src;
+	struct dst_entry *dst;
 
 	if (ipv6_addr_type(&fl6->daddr) &
 	    (IPV6_ADDR_MULTICAST | IPV6_ADDR_LINKLOCAL)) {
-		struct dst_entry *dst;
-
 		/* This function does not take refcnt on the dst */
 		dst = l3mdev_link_scope_lookup(net, fl6);
 		if (dst)
@@ -2688,7 +2721,35 @@
 	else if (sk)
 		flags |= rt6_srcprefs2flags(READ_ONCE(inet6_sk(sk)->srcprefs));
 
-	return fib6_rule_lookup(net, fl6, NULL, flags, ip6_pol_route_output);
+#if IS_ENABLED(CONFIG_NF_DYNRT)
+	/*
+	 * Dynamic source routing (DYNSRCROUTE target / DYNRT match):
+	 * forced output ifindex; a rejected lookup falls back to the
+	 * original flowi/flags.
+	 */
+	{
+		u32 dynrt_oif = dynrt_force_oif_fl6(net, fl6);
+
+		if (dynrt_oif) {
+			u32 saved_oif = fl6->flowi6_oif;
+			int saved_flags = flags;
+
+			fl6->flowi6_oif = dynrt_oif;
+			flags |= RT6_LOOKUP_F_IFACE;
+			dst = fib6_rule_lookup(net, fl6, NULL, flags,
+					       ip6_pol_route_output);
+			if (dst) {
+				fl6->flowi6_oif = saved_oif;
+				return dst;
+			}
+			fl6->flowi6_oif = saved_oif;
+			flags = saved_flags;
+		}
+	}
+#endif
+
+	dst = fib6_rule_lookup(net, fl6, NULL, flags, ip6_pol_route_output);
+	return dst;
 }
 
 struct dst_entry *ip6_route_output_flags(struct net *net,
