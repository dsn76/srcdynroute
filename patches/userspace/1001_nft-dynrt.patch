+// SPDX-License-Identifier: GPL-2.0
+/*
+ * dynrt.c -- statements for the srcdynroute kernel extension (nft CLI).
+ *
+ * DYNSRCROUTE (target) and DYNRT (match) are bare keyword statements that
+ * map 1:1 to the kernel expressions of the srcdynroute module.  The kernel
+ * expression names are matched case-sensitively, so keep them byte-for-byte
+ * identical to:
+ *   - the MODULE expression names in the module (nft_expr_type.name),
+ *   - the MODULE_ALIAS_NFT_EXPR() autoload aliases,
+ *   - these alloc_nft_expr()/netlink_parse table entries below.
+ */
+#include <nft.h>
+
+#include <stddef.h>
+#include <stdio.h>
+
+#include <statement.h>
+
+static void dynrt_srcroute_stmt_print(const struct stmt *stmt,
+				      struct output_ctx *octx)
+{
+	nft_print(octx, "DYNSRCROUTE");
+}
+
+const struct stmt_ops dynrt_srcroute_stmt_ops = {
+	.type		= STMT_DYNRT_SRCROUTE,
+	.name		= "dynsrcroute",
+	.print		= dynrt_srcroute_stmt_print,
+};
+
+struct stmt *dynrt_srcroute_stmt_alloc(const struct location *loc)
+{
+	return stmt_alloc(loc, &dynrt_srcroute_stmt_ops);
+}
+
+static void dynrt_stmt_print(const struct stmt *stmt,
+			     struct output_ctx *octx)
+{
+	nft_print(octx, "DYNRT");
+}
+
+const struct stmt_ops dynrt_stmt_ops = {
+	.type		= STMT_DYNRT,
+	.name		= "dynrt",
+	.print		= dynrt_stmt_print,
+};
+
+struct stmt *dynrt_stmt_alloc(const struct location *loc)
+{
+	return stmt_alloc(loc, &dynrt_stmt_ops);
+}
