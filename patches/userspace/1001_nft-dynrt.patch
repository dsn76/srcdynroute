+static void netlink_gen_dynrt_srcroute_stmt(struct netlink_linearize_ctx *ctx,
+					    const struct stmt *stmt)
+{
+	struct nftnl_expr *nle;
+
+	/* name must be byte-identical to the kernel expr name (case-sensitive) */
+	nle = alloc_nft_expr("DYNSRCROUTE");
+	nft_rule_add_expr(ctx, nle, &stmt->location);
+}
+
+static void netlink_gen_dynrt_stmt(struct netlink_linearize_ctx *ctx,
+				   const struct stmt *stmt)
+{
+	struct nftnl_expr *nle;
+
+	/* name must be byte-identical to the kernel expr name (case-sensitive) */
+	nle = alloc_nft_expr("DYNRT");
+	nft_rule_add_expr(ctx, nle, &stmt->location);
+}
+
 static void netlink_gen_set_stmt(struct netlink_linearize_ctx *ctx,
 				 const struct stmt *stmt)
 {
